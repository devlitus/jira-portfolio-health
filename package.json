{
  "name": "jira-portfolio-health",
  "version": "2.0.30",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:js": "esbuild src/frontend/index.tsx --bundle --minify --outfile=static/main/bundle.js",
    "build:css": "tailwindcss -i src/frontend/styles.css -o static/main/styles.css --minify",
    "build": "npm run build:css && npm run build:js",
    "watch:js": "esbuild src/frontend/index.tsx --bundle --outfile=static/main/bundle.js --watch",
    "watch:css": "tailwindcss -i src/frontend/styles.css -o static/main/styles.css --watch",
    "watch": "concurrently -n js,css \"npm:watch:js\" \"npm:watch:css\"",
    "lint": "eslint src/**/*.{ts,tsx}",
    "test": "jest",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^30.4.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@forge/api": "^8.0.3",
    "@forge/bridge": "^6.2.0",
    "@forge/kvs": "^2.0.3",
    "@forge/resolver": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
